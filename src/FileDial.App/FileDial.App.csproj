<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Версия SDK Windows — ради встроенных в систему PDF (страницы в картинки) и распознавания текста (OCR). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Только ради NotifyIcon (значок в трее); входит в .NET, сторонних пакетов нет. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FileDial</AssemblyName>
    <RootNamespace>FileDial.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DPI задан в app.manifest (PerMonitorV2) для всего процесса, включая меню трея. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationIcon>FileDial.ico</ApplicationIcon>

    <!-- Сведения о файле (свойства exe → «Подробно»). -->
    <Version>0.2.0</Version>
    <Product>FileDial</Product>
    <Company>FileDial</Company>
    <!-- AssemblyTitle — то, что Windows показывает как «Описание файла». -->
    <AssemblyTitle>FileDial — круговое меню действий для файлов</AssemblyTitle>
    <Description>FileDial — круговое меню действий для файлов</Description>
    <Copyright>FileDial, 2026</Copyright>

    <!-- Репозиторий GitHub для проверки обновлений: «владелец/репозиторий». Пусто — проверка выключена и скрыта. -->
    <UpdateRepository></UpdateRepository>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms и WPF содержат одноимённые типы; WinForms используем только явно. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileDial.Core\FileDial.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Тот же значок — для трея: из него берётся размер под текущий DPI. -->
    <EmbeddedResource Include="FileDial.ico" LogicalName="FileDial.ico" />
    <!-- Справка и внутри exe: установщик кладёт её в папку программы, даже если рядом с ним README нет. -->
    <EmbeddedResource Include="..\..\README.md" LogicalName="README.md" />
    <!-- WithCulture=false: иначе по «.ru» в имени MSBuild унесёт файл в отдельную сборку для русского языка. -->
    <EmbeddedResource Include="..\..\README.ru.md" LogicalName="README.ru.md" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- ExcludeFromSingleFile: справка лежит рядом с exe в zip, а не уходит внутрь (IncludeAllContentForSelfExtract). -->
    <None Include="..\..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\README.ru.md" Link="README.ru.md" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
