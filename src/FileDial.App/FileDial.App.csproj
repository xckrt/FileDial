<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Только ради NotifyIcon (значок в трее); входит в .NET, сторонних пакетов нет. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FileDial</AssemblyName>
    <RootNamespace>FileDial.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DPI задан в app.manifest (PerMonitorV2) для всего процесса, включая меню трея. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationIcon>FileDial.ico</ApplicationIcon>

    <!-- Сведения о файле (свойства exe → «Подробно»). -->
    <Version>0.1.0</Version>
    <Product>FileDial</Product>
    <Company>FileDial</Company>
    <!-- AssemblyTitle — то, что Windows показывает как «Описание файла». -->
    <AssemblyTitle>FileDial — круговое меню действий для файлов</AssemblyTitle>
    <Description>FileDial — круговое меню действий для файлов</Description>
    <Copyright>FileDial, 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms и WPF содержат одноимённые типы; WinForms используем только явно. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileDial.Core\FileDial.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Тот же значок — для трея: из него берётся размер под текущий DPI. -->
    <EmbeddedResource Include="FileDial.ico" LogicalName="FileDial.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
