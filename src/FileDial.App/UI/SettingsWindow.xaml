<Window x:Class="FileDial.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FileDial.App.UI"
        Title="{l:T UiSettingsWindowTitle}" Width="520" Height="1040"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" UseLayoutRounding="True">
    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource SectorBrush}"
            BorderThickness="1" CornerRadius="10" Padding="22,16,22,16"
            MouseLeftButtonDown="OnDragArea">
        <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" Text="{l:T UiSettingsTitle}" Foreground="{DynamicResource TextBrush}" FontSize="17"
                       FontWeight="SemiBold" />

            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="{l:T UiSave}" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnSave" />
                    <Button Content="{l:T UiCancel}" Style="{StaticResource FlatButton}" IsCancel="True" Click="OnCancel" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextBrush}" FontSize="12"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
            </DockPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <TextBlock Text="{l:T UiHotkeyTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBox x:Name="HotkeyBox" Style="{StaticResource FlatTextBox}" IsReadOnly="True"
                             IsReadOnlyCaretVisible="False" Cursor="Hand"
                             PreviewKeyDown="OnHotkeyKeyDown" GotKeyboardFocus="OnHotkeyFocus"
                             LostKeyboardFocus="OnHotkeyBlur" />
                    <TextBlock x:Name="HotkeyHint" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,6,0,0" />

                    <TextBlock Text="{l:T UiAppearanceTitle}" Style="{StaticResource SectionTitle}" />
                    <WrapPanel x:Name="ThemeChoices" />

                    <TextBlock Text="{l:T LanguageTitle}" Style="{StaticResource SectionTitle}" />
                    <WrapPanel x:Name="LanguageChoices" />

                    <TextBlock Text="{l:T UiGeneralTitle}" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="AutostartBox" Style="{StaticResource FlatCheckBox}"
                              Content="{l:T UiAutostart}" />
                    <CheckBox x:Name="ContextMenuBox" Style="{StaticResource FlatCheckBox}"
                              Content="{l:T CtxSettingsOption}" />
                    <CheckBox x:Name="AnimationsBox" Style="{StaticResource FlatCheckBox}" Content="{l:T UiAnimations}" />
                    <CheckBox x:Name="HistoryBox" Style="{StaticResource FlatCheckBox}"
                              Content="{l:T UiKeepHistory}" />

                    <TextBlock Text="{l:T UiOutputTitle}" Style="{StaticResource SectionTitle}" />
                    <RadioButton x:Name="NextToSourceRadio" GroupName="Output" Style="{StaticResource FlatRadio}"
                                 Content="{l:T UiOutputNextToSource}" Checked="OnOutputModeChanged" />
                    <RadioButton x:Name="FolderRadio" GroupName="Output" Style="{StaticResource FlatRadio}"
                                 Content="{l:T UiOutputToFolder}" Checked="OnOutputModeChanged" />
                    <DockPanel Margin="28,4,0,0">
                        <Button x:Name="PickOutputButton" DockPanel.Dock="Right" Content="{l:T UiBrowse}"
                                Style="{StaticResource FlatButton}" Click="OnPickOutputFolder" />
                        <TextBox x:Name="OutputFolderBox" Style="{StaticResource FlatTextBox}" IsReadOnly="True"
                                 FontSize="13" />
                    </DockPanel>
                    <CheckBox x:Name="OpenFolderBox" Style="{StaticResource FlatCheckBox}" Margin="0,8,0,0"
                              Content="{l:T UiOpenFolderWhenDone}" />

                    <TextBlock Text="{l:T UiVideoTargetTitle}" Style="{StaticResource SectionTitle}" />
                    <WrapPanel x:Name="VideoTargets" />
                    <TextBlock Text="{l:T UiImageTargetTitle}" Style="{StaticResource SectionTitle}" />
                    <WrapPanel x:Name="ImageTargets" />

                    <TextBlock x:Name="FfmpegSection" Text="ffmpeg" Style="{StaticResource SectionTitle}" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{l:T UiBrowse}" Style="{StaticResource FlatButton}" Click="OnPickFfmpegFolder" />
                            <Button Content="{l:T UiReset}" Style="{StaticResource FlatButton}" Click="OnResetFfmpegFolder" />
                        </StackPanel>
                        <TextBox x:Name="FfmpegFolderBox" Style="{StaticResource FlatTextBox}" IsReadOnly="True"
                                 FontSize="13" />
                    </DockPanel>
                    <TextBlock x:Name="FfmpegStatus" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                    <WrapPanel x:Name="FfmpegInstallButtons" Margin="0,8,0,0" />
                    <StackPanel x:Name="FfmpegPanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:T UiCancel}" Style="{StaticResource SmallButton}"
                                    Margin="8,0,0,0" Click="OnCancelFfmpegInstall" />
                            <TextBlock x:Name="FfmpegInstallText" Foreground="{DynamicResource TextBrush}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <ProgressBar x:Name="FfmpegProgress" Style="{StaticResource FlatProgress}" Minimum="0"
                                     Maximum="1" Margin="0,6,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="SpeechSection" Text="{l:T UiSpeechTitle}"
                               Style="{StaticResource SectionTitle}" />
                    <WrapPanel x:Name="DownloadButtons" Margin="0,0,0,8" />
                    <StackPanel x:Name="DownloadPanel" Visibility="Collapsed" Margin="0,0,0,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:T UiCancel}" Style="{StaticResource SmallButton}"
                                    Margin="8,0,0,0" Click="OnCancelDownload" />
                            <TextBlock x:Name="DownloadText" Foreground="{DynamicResource TextBrush}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <ProgressBar x:Name="DownloadProgress" Style="{StaticResource FlatProgress}" Minimum="0"
                                     Maximum="1" Margin="0,6,0,0" />
                    </StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{l:T UiBrowse}" Style="{StaticResource FlatButton}" Click="OnPickWhisperModel" />
                            <Button Content="{l:T UiReset}" Style="{StaticResource FlatButton}" Click="OnResetWhisperModel" />
                        </StackPanel>
                        <TextBox x:Name="WhisperModelBox" Style="{StaticResource FlatTextBox}" IsReadOnly="True"
                                 FontSize="13" />
                    </DockPanel>
                    <TextBlock x:Name="WhisperStatus" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,6,0,8" />
                    <WrapPanel x:Name="WhisperLanguages" />

                    <!-- Мои действия: список со своими кнопками, редактор — отдельное окно. -->
                    <TextBlock Text="{l:T CstSectionTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{l:T CstSectionHint}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,8" />
                    <StackPanel x:Name="CustomList" />
                    <Button Content="{l:T CstAdd}" Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                            Margin="0,4,0,0" Click="OnAddCustomAction" />
                    <TextBlock x:Name="BackgroundSection" Text="{l:T BgSettingsTitle}"
                               Style="{StaticResource SectionTitle}" />
                    <WrapPanel x:Name="BgDownloadButtons" Margin="0,0,0,8" />
                    <StackPanel x:Name="BgDownloadPanel" Visibility="Collapsed" Margin="0,0,0,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:T UiCancel}" Style="{StaticResource SmallButton}"
                                    Margin="8,0,0,0" Click="OnCancelBgDownload" />
                            <TextBlock x:Name="BgDownloadText" Foreground="{DynamicResource TextBrush}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <ProgressBar x:Name="BgDownloadProgress" Style="{StaticResource FlatProgress}" Minimum="0"
                                     Maximum="1" Margin="0,6,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="BgStatus" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
