<Window x:Class="FileDial.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileDial — настройки" Width="520" Height="930"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" UseLayoutRounding="True">
    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource SectorBrush}"
            BorderThickness="1" CornerRadius="10" Padding="22,16,22,16"
            MouseLeftButtonDown="OnDragArea">
        <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" Text="Настройки" Foreground="{StaticResource TextBrush}" FontSize="17"
                       FontWeight="SemiBold" />

            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Сохранить" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnSave" />
                    <Button Content="Отмена" Style="{StaticResource FlatButton}" IsCancel="True" Click="OnCancel" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource TextBrush}" FontSize="12"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
            </DockPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <TextBlock Text="Горячая клавиша" Style="{StaticResource SectionTitle}" />
                    <TextBox x:Name="HotkeyBox" Style="{StaticResource FlatTextBox}" IsReadOnly="True"
                             IsReadOnlyCaretVisible="False" Cursor="Hand"
                             PreviewKeyDown="OnHotkeyKeyDown" GotKeyboardFocus="OnHotkeyFocus"
                             LostKeyboardFocus="OnHotkeyBlur" />
                    <TextBlock x:Name="HotkeyHint" Foreground="{StaticResource MutedBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Щёлкните поле и нажмите сочетание: Ctrl, Alt или Win вместе с буквой, цифрой или F1–F24." />

                    <TextBlock Text="Общее" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="AutostartBox" Style="{StaticResource FlatCheckBox}"
                              Content="Запускать вместе с Windows" />
                    <CheckBox x:Name="AnimationsBox" Style="{StaticResource FlatCheckBox}" Content="Анимации" />
                    <CheckBox x:Name="HistoryBox" Style="{StaticResource FlatCheckBox}"
                              Content="Вести историю действий (хранится только на этом компьютере)" />

                    <TextBlock Text="Куда сохранять результаты" Style="{StaticResource SectionTitle}" />
                    <RadioButton x:Name="NextToSourceRadio" GroupName="Output" Style="{StaticResource FlatRadio}"
                                 Content="Рядом с исходным файлом" Checked="OnOutputModeChanged" />
                    <RadioButton x:Name="FolderRadio" GroupName="Output" Style="{StaticResource FlatRadio}"
                                 Content="В выбранную папку" Checked="OnOutputModeChanged" />
                    <DockPanel Margin="28,4,0,0">
                        <Button x:Name="PickOutputButton" DockPanel.Dock="Right" Content="Выбрать…"
                                Style="{StaticResource FlatButton}" Click="OnPickOutputFolder" />
                        <TextBox x:Name="OutputFolderBox" Style="{StaticResource FlatTextBox}" IsReadOnly="True"
                                 FontSize="13" />
                    </DockPanel>
                    <CheckBox x:Name="OpenFolderBox" Style="{StaticResource FlatCheckBox}" Margin="0,8,0,0"
                              Content="Открывать папку с результатом после завершения" />

                    <TextBlock Text="Сжатие видео — цель" Style="{StaticResource SectionTitle}" />
                    <WrapPanel x:Name="VideoTargets" />
                    <TextBlock Text="Сжатие картинок — цель" Style="{StaticResource SectionTitle}" />
                    <WrapPanel x:Name="ImageTargets" />

                    <TextBlock Text="ffmpeg" Style="{StaticResource SectionTitle}" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Выбрать…" Style="{StaticResource FlatButton}" Click="OnPickFfmpegFolder" />
                            <Button Content="Сбросить" Style="{StaticResource FlatButton}" Click="OnResetFfmpegFolder" />
                        </StackPanel>
                        <TextBox x:Name="FfmpegFolderBox" Style="{StaticResource FlatTextBox}" IsReadOnly="True"
                                 FontSize="13" />
                    </DockPanel>
                    <TextBlock x:Name="FfmpegStatus" Foreground="{StaticResource MutedBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,6,0,0" />

                    <TextBlock x:Name="SpeechSection" Text="Распознавание речи (субтитры, текст)"
                               Style="{StaticResource SectionTitle}" />
                    <WrapPanel x:Name="DownloadButtons" Margin="0,0,0,8" />
                    <StackPanel x:Name="DownloadPanel" Visibility="Collapsed" Margin="0,0,0,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Отмена" Style="{StaticResource SmallButton}"
                                    Margin="8,0,0,0" Click="OnCancelDownload" />
                            <TextBlock x:Name="DownloadText" Foreground="{StaticResource TextBrush}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <ProgressBar x:Name="DownloadProgress" Style="{StaticResource FlatProgress}" Minimum="0"
                                     Maximum="1" Margin="0,6,0,0" />
                    </StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Выбрать…" Style="{StaticResource FlatButton}" Click="OnPickWhisperModel" />
                            <Button Content="Сбросить" Style="{StaticResource FlatButton}" Click="OnResetWhisperModel" />
                        </StackPanel>
                        <TextBox x:Name="WhisperModelBox" Style="{StaticResource FlatTextBox}" IsReadOnly="True"
                                 FontSize="13" />
                    </DockPanel>
                    <TextBlock x:Name="WhisperStatus" Foreground="{StaticResource MutedBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,6,0,8" />
                    <WrapPanel x:Name="WhisperLanguages" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
