<Window x:Class="FileDial.App.UI.JobWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileDial" Width="440" Height="236"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" UseLayoutRounding="True">
    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource SectorBrush}"
            BorderThickness="1" CornerRadius="10" Padding="20,16,20,16"
            MouseLeftButtonDown="OnDragArea">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="RevealButton" Content="Показать в папке" Style="{StaticResource AccentButton}"
                        Visibility="Collapsed" Click="OnReveal" />
                <Button x:Name="CancelButton" Content="Отмена" Style="{StaticResource FlatButton}" Click="OnCancel"
                        IsCancel="True" />
                <Button x:Name="CloseButton" Content="Закрыть" Style="{StaticResource FlatButton}" Click="OnClose"
                        Visibility="Collapsed" />
            </StackPanel>

            <StackPanel>
                <TextBlock x:Name="ActionText" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                <TextBlock x:Name="FileNameText" Foreground="{StaticResource TextBrush}" FontSize="15"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,12" />

                <DockPanel>
                    <TextBlock x:Name="PercentText" DockPanel.Dock="Right" Foreground="{StaticResource TextBrush}"
                               FontSize="13" />
                    <TextBlock x:Name="StageText" Foreground="{StaticResource TextBrush}" FontSize="13"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <ProgressBar x:Name="ProgressIndicator" Style="{StaticResource FlatProgress}" Minimum="0" Maximum="1"
                             Margin="0,8,0,0" />

                <TextBlock x:Name="MessageText" Foreground="{StaticResource TextBrush}" FontSize="13"
                           TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" MaxHeight="58"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="HelpLinkText" Margin="0,6,0,0" FontSize="13" Visibility="Collapsed">
                    <Hyperlink Foreground="{StaticResource AccentBrush}" Click="OnOpenReadme">
                        Установить ffmpeg одной кнопкой
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
