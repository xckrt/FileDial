<Window x:Class="FileDial.App.UI.ContentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FileDial.App.UI"
        Title="{l:T UiContentsWindowTitle}" Width="560" Height="600"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" UseLayoutRounding="True">
    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource SectorBrush}"
            BorderThickness="1" CornerRadius="10" Padding="22,16,22,16"
            MouseLeftButtonDown="OnDragArea">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="{l:T UiArchiveContents}" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                <TextBlock x:Name="ArchiveName" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,2" />
                <TextBlock x:Name="SummaryText" Foreground="{DynamicResource MutedBrush}" FontSize="12" Text="{l:T UiReadingArchive}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="ExtractButton" Content="{l:T ExtractHere}" Style="{StaticResource AccentButton}"
                        IsEnabled="False" Click="OnExtract" />
                <Button Content="{l:T UiClose}" Style="{StaticResource FlatButton}" IsCancel="True" Click="OnClose" />
            </StackPanel>

            <!-- Виртуализация: архив на десятки тысяч файлов не тормозит окно. -->
            <ItemsControl x:Name="EntriesList" VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="True" Focusable="False" VerticalScrollBarVisibility="Auto"
                                      Padding="0,0,6,0">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontSize="12" Margin="12,0,0,0"
                                       Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock Text="{Binding Display}" Foreground="{Binding Brush}" FontSize="13"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</Window>
