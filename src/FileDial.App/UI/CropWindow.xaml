<Window x:Class="FileDial.App.UI.CropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FileDial.App.UI"
        Title="{l:T ImgCropWindowTitle}" Width="580" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" UseLayoutRounding="True" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource SectorBrush}"
            BorderThickness="1" CornerRadius="10" Padding="20,16,20,16"
            MouseLeftButtonDown="OnDragArea">
        <StackPanel>
            <TextBlock Text="{l:T ImgCropCaption}" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
            <TextBlock x:Name="FileText" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" Margin="0,2,0,2" />
            <TextBlock x:Name="SizeText" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,12" />

            <!-- Превью с рамкой: затемнение снаружи, линии третей, угловые ручки. -->
            <Grid x:Name="PreviewHost" HorizontalAlignment="Center" Margin="0,0,0,12" ClipToBounds="True">
                <Rectangle x:Name="Placeholder" Fill="{DynamicResource SectorBrush}" />
                <Image x:Name="PreviewImage" Stretch="Fill" />
                <TextBlock x:Name="PreviewStatus" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="16" />
                <Canvas x:Name="Overlay" Background="Transparent"
                        MouseLeftButtonDown="OnOverlayDown" MouseMove="OnOverlayMove" MouseLeftButtonUp="OnOverlayUp"
                        LostMouseCapture="OnOverlayLostCapture" />
            </Grid>

            <TextBlock Text="{l:T ImgAspect}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,6" />
            <DockPanel LastChildFill="True">
                <Button x:Name="SwapButton" DockPanel.Dock="Right" Content="↔" Style="{StaticResource SmallButton}"
                        FontSize="14" Margin="6,0,0,6" VerticalAlignment="Top" ToolTip="{l:T ImgSwapOrientation}"
                        Click="OnSwap" />
                <WrapPanel x:Name="Aspects" />
            </DockPanel>

            <StackPanel x:Name="AnchorPanel">
                <TextBlock Text="{l:T ImgPosition}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,6" />
                <WrapPanel x:Name="Anchors" />
            </StackPanel>

            <TextBlock x:Name="ResultText" Foreground="{DynamicResource TextBrush}" FontSize="13" TextWrapping="Wrap"
                       Margin="0,14,0,0" />
            <TextBlock x:Name="NoteText" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                       Margin="0,4,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="OkButton" Content="{l:T ImgCropOk}" Style="{StaticResource AccentButton}" IsDefault="True"
                        IsEnabled="False" Click="OnOk" />
                <Button Content="{l:T UiCancel}" Style="{StaticResource FlatButton}" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
