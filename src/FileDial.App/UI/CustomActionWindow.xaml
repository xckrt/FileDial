<Window x:Class="FileDial.App.UI.CustomActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FileDial.App.UI"
        Title="{l:T CstWindowTitle}" Width="560" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" UseLayoutRounding="True" WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource SectorBrush}"
            BorderThickness="1" CornerRadius="10" Padding="20,16,20,16"
            MouseLeftButtonDown="OnDragArea">
        <StackPanel>
            <TextBlock x:Name="HeadingText" Foreground="{DynamicResource TextBrush}" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="{l:T CstRightsNote}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,4,0,0" />

            <TextBlock Text="{l:T CstName}" Style="{StaticResource SectionTitle}" />
            <TextBox x:Name="NameBox" Style="{StaticResource FlatTextBox}" FontSize="14" TextChanged="OnChanged" />

            <TextBlock Text="{l:T CstAppliesTo}" Style="{StaticResource SectionTitle}" />
            <WrapPanel x:Name="KindChoices" />
            <StackPanel x:Name="ExtensionsPanel" Visibility="Collapsed" Margin="0,2,0,0">
                <TextBox x:Name="ExtensionsBox" Style="{StaticResource FlatTextBox}" FontSize="13"
                         TextChanged="OnChanged" />
                <TextBlock Text="{l:T CstExtensionsHint}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                           Margin="0,4,0,0" />
            </StackPanel>

            <TextBlock Text="{l:T CstProgram}" Style="{StaticResource SectionTitle}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{l:T UiBrowse}" Style="{StaticResource FlatButton}"
                        Click="OnBrowseProgram" />
                <TextBox x:Name="ProgramBox" Style="{StaticResource FlatTextBox}" FontSize="13" FontFamily="Consolas"
                         TextChanged="OnChanged" />
            </DockPanel>
            <TextBlock Text="{l:T CstProgramHint}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,4,0,0" />

            <TextBlock Text="{l:T CstArguments}" Style="{StaticResource SectionTitle}" />
            <TextBox x:Name="ArgumentsBox" Style="{StaticResource FlatTextBox}" FontSize="13" FontFamily="Consolas"
                     TextChanged="OnChanged" />
            <TextBlock Text="{l:T CstVariablesHint}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,4,0,0" />

            <TextBlock Text="{l:T CstOutputTitle}" Style="{StaticResource SectionTitle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{l:T CstSuffix}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                               Margin="0,0,0,4" />
                    <TextBox x:Name="SuffixBox" Style="{StaticResource FlatTextBox}" FontSize="13"
                             TextChanged="OnChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:T CstExtension}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                               Margin="0,0,0,4" />
                    <TextBox x:Name="ExtensionBox" Style="{StaticResource FlatTextBox}" FontSize="13"
                             TextChanged="OnChanged" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{l:T CstOutputHint}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,4,0,0" />

            <CheckBox x:Name="ShowWindowBox" Style="{StaticResource FlatCheckBox}" Margin="0,12,0,0"
                      Content="{l:T CstShowWindow}" Checked="OnChanged" Unchecked="OnChanged" />
            <TextBlock Text="{l:T CstShowWindowHint}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                       TextWrapping="Wrap" Margin="28,0,0,0" />

            <TextBlock Text="{l:T CstPreview}" Style="{StaticResource SectionTitle}" />
            <Border Background="{DynamicResource SectorBrush}" CornerRadius="6" Padding="10,8">
                <TextBlock x:Name="PreviewText" Foreground="{DynamicResource TextBrush}" FontSize="12"
                           FontFamily="Consolas" TextWrapping="Wrap" />
            </Border>

            <WrapPanel Margin="0,12,0,0">
                <TextBlock Text="{l:T CstExamples}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,0,6" />
                <Button Content="{l:T CstExampleFfmpeg}" Style="{StaticResource SmallButton}" Margin="8,0,0,6"
                        Click="OnExampleFfmpeg" />
                <Button Content="{l:T CstExampleNotepad}" Style="{StaticResource SmallButton}" Margin="8,0,0,6"
                        Click="OnExampleNotepad" />
                <Button Content="{l:T CstExampleMagick}" Style="{StaticResource SmallButton}" Margin="8,0,0,6"
                        Click="OnExampleMagick" />
            </WrapPanel>

            <DockPanel Margin="0,10,0,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="SaveButton" Content="{l:T UiSave}" Style="{StaticResource AccentButton}"
                            IsDefault="True" Click="OnSave" />
                    <Button Content="{l:T UiCancel}" Style="{StaticResource FlatButton}" IsCancel="True" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextBrush}" FontSize="12"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
