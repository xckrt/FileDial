<Window x:Class="FileDial.App.UI.ResizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FileDial.App.UI"
        Title="{l:T RszWindowTitle}" Width="500" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" UseLayoutRounding="True" WindowStartupLocation="CenterScreen">
    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource SectorBrush}"
            BorderThickness="1" CornerRadius="10" Padding="20,16,20,16"
            MouseLeftButtonDown="OnDragArea">
        <StackPanel>
            <TextBlock Text="{l:T RszCaption}" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
            <TextBlock x:Name="FileText" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" Margin="0,2,0,2" />
            <TextBlock x:Name="SizeText" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,12" />

            <TextBlock Text="{l:T RszByLongSide}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,6" />
            <WrapPanel x:Name="LongSides" />

            <TextBlock Text="{l:T RszByPercent}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,6" />
            <WrapPanel x:Name="Percents" />

            <TextBlock Text="{l:T RszCustom}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,6" />
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="WidthBox" Style="{StaticResource FlatTextBox}" Width="96" ToolTip="{l:T RszWidth}"
                         TextChanged="OnCustomChanged" />
                <TextBlock Text="×" Foreground="{DynamicResource MutedBrush}" FontSize="15" VerticalAlignment="Center"
                           Margin="8,0,8,0" />
                <TextBox x:Name="HeightBox" Style="{StaticResource FlatTextBox}" Width="96" ToolTip="{l:T RszHeight}"
                         TextChanged="OnCustomChanged" />
                <CheckBox x:Name="KeepAspectBox" Style="{StaticResource FlatCheckBox}" Content="{l:T RszKeepAspect}"
                          IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center"
                          Checked="OnKeepAspectChanged" Unchecked="OnKeepAspectChanged" />
            </StackPanel>

            <TextBlock x:Name="ResultText" Foreground="{DynamicResource TextBrush}" FontSize="13" TextWrapping="Wrap"
                       Margin="0,14,0,0" />
            <TextBlock x:Name="NoteText" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                       Margin="0,4,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="OkButton" Content="{l:T RszOk}" Style="{StaticResource AccentButton}" IsDefault="True"
                        IsEnabled="False" Click="OnOk" />
                <Button Content="{l:T UiCancel}" Style="{StaticResource FlatButton}" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
