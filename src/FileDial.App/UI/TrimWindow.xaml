<Window x:Class="FileDial.App.UI.TrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileDial — обрезать" Width="440" Height="300"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" UseLayoutRounding="True">
    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource SectorBrush}"
            BorderThickness="1" CornerRadius="10" Padding="20,16,20,16"
            MouseLeftButtonDown="OnDragArea">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="TrimButton" Content="Обрезать" Style="{StaticResource AccentButton}" IsDefault="True"
                        IsEnabled="False" Click="OnTrim" />
                <Button Content="Отмена" Style="{StaticResource FlatButton}" IsCancel="True" Click="OnCancel" />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Обрезать" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                <TextBlock x:Name="FileNameText" Foreground="{DynamicResource TextBrush}" FontSize="15"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,2" />
                <TextBlock x:Name="DurationText" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                           Text="Читаю файл…" Margin="0,0,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Начало" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox x:Name="StartBox" Style="{StaticResource FlatTextBox}" IsEnabled="False"
                                 TextChanged="OnInputChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Конец" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox x:Name="EndBox" Style="{StaticResource FlatTextBox}" IsEnabled="False"
                                 TextChanged="OnInputChanged" />
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="PreciseBox" Checked="OnPreciseChanged" Unchecked="OnPreciseChanged" Margin="0,12,0,0" IsChecked="True" Foreground="{DynamicResource TextBrush}"
                          FontSize="13" Visibility="Collapsed"
                          Content="Точно по кадрам (дольше: видео перекодируется)" />
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextBrush}" FontSize="13"
                           TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
