<Window x:Class="FileDial.App.UI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileDial — история" Width="560" Height="640"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" UseLayoutRounding="True">
    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource SectorBrush}"
            BorderThickness="1" CornerRadius="10" Padding="22,16,22,16"
            MouseLeftButtonDown="OnDragArea">
        <DockPanel LastChildFill="True">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Очистить" Style="{StaticResource FlatButton}"
                        Click="OnClear" />
                <StackPanel>
                    <TextBlock Text="История" Foreground="{DynamicResource TextBrush}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="SummaryText" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Закрыть" Style="{StaticResource FlatButton}" IsCancel="True" Click="OnClose" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,6,0">
                <StackPanel x:Name="ListPanel" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
