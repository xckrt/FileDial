<Window x:Class="FileDial.App.UI.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FileDial.App.UI"
        Title="{l:T UiPasswordWindowTitle}" Width="420" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" UseLayoutRounding="True" WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource SectorBrush}"
            BorderThickness="1" CornerRadius="10" Padding="20,16,20,16"
            MouseLeftButtonDown="OnDragArea">
        <StackPanel>
            <TextBlock x:Name="TitleText" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
            <TextBlock x:Name="FileText" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" Margin="0,2,0,12" />

            <TextBlock Text="{l:T UiPassword}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,4" />
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource FlatPasswordBox}" PasswordChanged="OnChanged" />

            <StackPanel x:Name="ConfirmPanel">
                <TextBlock Text="{l:T UiPasswordRepeat}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,10,0,4" />
                <PasswordBox x:Name="ConfirmBox" Style="{StaticResource FlatPasswordBox}" PasswordChanged="OnChanged" />
            </StackPanel>

            <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                       Margin="0,10,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="OkButton" Style="{StaticResource AccentButton}" IsDefault="True" IsEnabled="False"
                        Click="OnOk" />
                <Button Content="{l:T UiCancel}" Style="{StaticResource FlatButton}" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
