<?xml version="1.0" encoding="utf-8"?>
<!-- Сборка для раздачи: один самодостаточный FileDial.exe для Windows x64 (.NET ставить не нужно). -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Нативные библиотеки WPF — внутри exe, распаковываются при первом запуске. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Сжатый exe (~80 МБ вместо ~190 МБ — столько и качает обновление) распаковывается целиком один раз
         в %TEMP%\.net\FileDial\<хеш>: первый запуск ~1,5 с, дальше как без сжатия. Память та же (~105 МБ):
         сборки отображаются с диска. Сжатие без распаковки на диск держало их в памяти — ~240 МБ.
         «Рядом с exe» поэтому — AppPaths.ExeFolder, а не AppContext.BaseDirectory. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- Отладочные символы внутри exe: в журнале ошибок будут номера строк, лишних .pdb рядом нет. -->
    <DebugType>embedded</DebugType>
    <PublishDir>..\..\dist\FileDial\</PublishDir>
  </PropertyGroup>
</Project>
