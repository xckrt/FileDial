<?xml version="1.0" encoding="utf-8"?>
<!-- Сборка для раздачи: один самодостаточный FileDial.exe для Windows x64 (.NET ставить не нужно). -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Нативные библиотеки WPF — внутри exe, распаковываются при первом запуске. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Без сжатия: со сжатием сборки распаковываются в память при каждом запуске и программа в трее
         занимает ~240 МБ вместо ~110 МБ. Размер zip для раздачи от этого почти не меняется. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- Отладочные символы внутри exe: в журнале ошибок будут номера строк, лишних .pdb рядом нет. -->
    <DebugType>embedded</DebugType>
    <PublishDir>..\..\dist\FileDial\</PublishDir>
  </PropertyGroup>
</Project>
