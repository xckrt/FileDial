<Window x:Class="FileDial.App.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:setup="clr-namespace:FileDial.App.Setup"
        xmlns:l="clr-namespace:FileDial.App.UI"
        Title="{l:T SetupWindowTitle}" Width="800" Height="548"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" UseLayoutRounding="True" WindowStartupLocation="CenterScreen">
    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource RimBrush}"
            BorderThickness="1" CornerRadius="14" MouseLeftButtonDown="OnDragArea">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Слева — круг: то, ради чего программа, и заодно индикатор хода установки. -->
            <Grid Grid.Column="0" Margin="28,28,8,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="DialHost" Width="256" Height="256" VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="DialScale" />
                            <RotateTransform x:Name="DialSpin" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <setup:DialArt x:Name="Dial" />
                    <!-- Центр: горячая клавиша, проценты или отметка «готово». -->
                    <Grid Width="100" Height="100">
                        <TextBlock x:Name="CenterText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" Foreground="{DynamicResource TextBrush}"
                                   FontFamily="Bahnschrift SemiCondensed, Bahnschrift, Segoe UI" FontSize="15" />
                        <Path x:Name="DoneMark" Data="M0,9 L7,16 L20,1" Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="Collapsed" />
                    </Grid>
                </Grid>
                <TextBlock x:Name="VersionText" Grid.Row="1" HorizontalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" />
            </Grid>

            <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
                    x:Name="CloseButton" Style="{StaticResource FlatButton}" Padding="8" Click="OnCloseClick"
                    ToolTip="{l:T SetupClose}">
                <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Button>

            <Grid Grid.Column="1" Margin="12,36,36,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Установка: папка, тема, дополнительно. -->
                <StackPanel x:Name="OptionsPage">
                    <TextBlock Text="FileDial" Foreground="{DynamicResource TextBrush}" FontSize="32"
                               FontFamily="Bahnschrift, Segoe UI" FontWeight="SemiBold" />
                    <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap"
                               Margin="0,4,0,0" LineHeight="19"
                               Text="{l:T SetupTagline}" />
                    <TextBlock x:Name="UpdateNote" Foreground="{DynamicResource TextBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

                    <TextBlock Text="{l:T SetupFolderTitle}" Style="{StaticResource SectionTitle}" />
                    <DockPanel>
                        <Button x:Name="ChangeFolderButton" DockPanel.Dock="Right" Content="{l:T SetupChangeFolder}"
                                Style="{StaticResource FlatButton}" Click="OnChangeFolder" />
                        <TextBox x:Name="FolderBox" Style="{StaticResource FlatTextBox}" IsReadOnly="True" FontSize="13" />
                    </DockPanel>
                    <TextBlock x:Name="FolderStatus" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,6,0,0" />

                    <!-- Тема и язык — две строки под одним заголовком: окно фиксированной высоты. -->
                    <TextBlock Text="{l:T SetupLookTitle}" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{l:T SetupThemeLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <WrapPanel x:Name="ThemeChoices" Grid.Column="1" />
                        <TextBlock Grid.Row="1" Text="{l:T LanguageTitle}" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,6,12,0" />
                        <WrapPanel x:Name="LanguageChoices" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" />
                    </Grid>

                    <TextBlock Text="{l:T SetupMoreTitle}" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="AutostartBox" Style="{StaticResource FlatCheckBox}" IsChecked="True"
                              Content="{l:T SetupAutostart}" />
                    <!-- Оба ярлыка в одну строку — место под выбор языка. -->
                    <WrapPanel>
                        <CheckBox x:Name="StartMenuBox" Style="{StaticResource FlatCheckBox}" IsChecked="True"
                                  Content="{l:T SetupStartMenuShortcut}" Margin="0,4,24,4" />
                        <CheckBox x:Name="DesktopBox" Style="{StaticResource FlatCheckBox}"
                                  Content="{l:T SetupDesktopShortcut}" />
                    </WrapPanel>
                </StackPanel>

                <!-- Удаление. -->
                <StackPanel x:Name="UninstallPage" Visibility="Collapsed">
                    <TextBlock Text="{l:T SetupUninstallTitle}" Foreground="{DynamicResource TextBrush}" FontSize="32"
                               FontFamily="Bahnschrift, Segoe UI" FontWeight="SemiBold" />
                    <TextBlock x:Name="UninstallText" Foreground="{DynamicResource MutedBrush}" FontSize="13"
                               TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="19" />
                    <CheckBox x:Name="RemoveDataBox" Style="{StaticResource FlatCheckBox}" Margin="0,18,0,0" />
                    <TextBlock x:Name="RemoveDataHint" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="28,2,0,0" />
                </StackPanel>

                <!-- Ход работы и итог. -->
                <StackPanel x:Name="ProgressPage" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock x:Name="ProgressTitle" Foreground="{DynamicResource TextBrush}" FontSize="32"
                               FontFamily="Bahnschrift, Segoe UI" FontWeight="SemiBold" />
                    <TextBlock x:Name="StageText" Foreground="{DynamicResource MutedBrush}" FontSize="13"
                               TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19" />
                </StackPanel>

                <StackPanel x:Name="DonePage" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock x:Name="DoneTitle" Foreground="{DynamicResource TextBrush}" FontSize="32"
                               FontFamily="Bahnschrift, Segoe UI" FontWeight="SemiBold" />
                    <TextBlock x:Name="DoneText" Foreground="{DynamicResource MutedBrush}" FontSize="13"
                               TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19" />
                    <StackPanel x:Name="HowTo" Margin="0,20,0,0" />
                    <CheckBox x:Name="LaunchBox" Style="{StaticResource FlatCheckBox}" IsChecked="True"
                              Content="{l:T SetupLaunch}" Margin="0,18,0,0" />
                </StackPanel>

                <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,16,0,0">
                    <TextBlock x:Name="FooterNote" DockPanel.Dock="Left" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}" FontSize="12"
                               Text="{l:T SetupNoAdmin}" />
                    <Button x:Name="PrimaryButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}"
                            IsDefault="True" Click="OnPrimary" Margin="8,0,0,0" />
                    <Button x:Name="SecondaryButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}"
                            Content="{l:T SetupCancel}" Click="OnSecondary" />
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
